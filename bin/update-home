#!/usr/bin/env bash
# Update Home Manager configuration
#
# Usage:
#   ./bin/update-home                    # Use remote deepwork flake
#   ./bin/update-home --local            # Use local deepwork flake (../deepwork)
#   ./bin/update-home --local /path/to   # Use local deepwork flake at custom path
#
# This script runs home-manager switch with the flake configuration.
# Use --local to override the deepwork input with a local checkout for development.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FLAKE_DIR="$(dirname "$SCRIPT_DIR")"

LOCAL_DEEPWORK=""
OVERRIDE_ARGS=""

# Parse arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    --local)
      if [[ -n "${2:-}" && ! "$2" =~ ^-- ]]; then
        LOCAL_DEEPWORK="$2"
        shift
      else
        LOCAL_DEEPWORK="$FLAKE_DIR/../deepwork"
      fi
      shift
      ;;
    *)
      echo "Unknown option: $1"
      echo "Usage: $0 [--local [/path/to/deepwork]]"
      exit 1
      ;;
  esac
done

# Build override arguments if using local deepwork
if [[ -n "$LOCAL_DEEPWORK" ]]; then
  if [[ ! -d "$LOCAL_DEEPWORK" ]]; then
    echo "Error: Local deepwork directory not found: $LOCAL_DEEPWORK"
    exit 1
  fi
  LOCAL_DEEPWORK="$(cd "$LOCAL_DEEPWORK" && pwd)"
  echo "Using local deepwork flake: $LOCAL_DEEPWORK"
  OVERRIDE_ARGS="--override-input deepwork path:$LOCAL_DEEPWORK"
fi

cd "$FLAKE_DIR"

# Run home-manager switch
echo "Switching Home Manager configuration..."
# shellcheck disable=SC2086
nix run home-manager/master -- switch --flake .#macbook $OVERRIDE_ARGS "$@"

echo "Home Manager configuration updated successfully!"
